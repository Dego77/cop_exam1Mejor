generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int                   @id @default(autoincrement())
  email          String                @unique
  password       String
  fullName       String
  avatarUrl      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  projects       Project[]             @relation("ProjectOwner")
  collaborations ProjectCollaborator[]
  aiChats        AIChatHistory[]
  workSessions   WorkSession[]
}

model Project {
  id             String                @id @default(uuid())
  name           String
  description    String?
  ownerId        Int
  owner          User                  @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  collaborators  ProjectCollaborator[]
  diagrams       Diagram[]
  aiChats        AIChatHistory[]
  architectSyncs ArchitectSync[]
  workSessions   WorkSession[]
}

model ProjectCollaborator {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("EDITOR")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
}

model Diagram {
  id         String      @id @default(uuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String      @default("E-Commerce Model")
  gridOn     Boolean     @default(true)
  zoom       Float       @default(100)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  nodes      Node[]
  connectors Connector[]
}

model Node {
  id               String      @id @default(uuid())
  diagramId        String
  diagram          Diagram     @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  name             String
  stereotype       String      @default("Entity")
  attributes       Json
  methods          Json
  positionX        Float
  positionY        Float
  width            Float       @default(220)
  height           Float       @default(180)
  sourceConnectors Connector[] @relation("SourceNode")
  targetConnectors Connector[] @relation("TargetNode")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Connector {
  id                 String   @id @default(uuid())
  diagramId          String
  diagram            Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  sourceNodeId       String
  sourceNode         Node     @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId       String
  targetNode         Node     @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  type               String
  sourceMultiplicity String?
  targetMultiplicity String?
  label              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AIChatHistory {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    String
  mode      String
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())
}

model ArchitectSync {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  direction  String
  xmiContent String   @db.Text
  status     String
  timestamp  DateTime @default(now())
}

model WorkSession {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime  @default(now())
  endTime   DateTime?
  duration  Int?      // Duration in seconds
  socketId  String?
  createdAt DateTime  @default(now())
}
